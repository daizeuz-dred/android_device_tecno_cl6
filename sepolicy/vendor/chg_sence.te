type chg_sence, domain;
type chg_sence_exec, exec_type, file_type, vendor_file_type;
type sysfs_bat_cycle, fs_type, sysfs_type;
type sysfs_chgspeed_ctl_file, fs_type, sysfs_type, mlstrustedobject;
type sysfs_cc_status, fs_type, sysfs_type;
type sysfs_tran_chg_file, fs_type, sysfs_type;

allow chg_sence self:netlink_kobject_uevent_socket { read create bind getopt setopt };
init_daemon_domain(chg_sence)

allow chg_sence nvdata_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow chg_sence nvdata_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow chg_sence nvdata_file:lnk_file { ioctl read write getattr lock append map open watch watch_reads };
allow chg_sence nvram_data_file:lnk_file { ioctl read write getattr lock append map open watch watch_reads };
allow chg_sence nvcfg_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow chg_sence nvcfg_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow chg_sence mnt_vendor_file:dir { search };
allow chg_sence sysfs_boot_mode:file { ioctl read getattr lock map open watch watch_reads };
allow chg_sence sysfs_pump_express:file { read write getattr open };
allow chg_sence sysfs_bat_cycle:file { read write getattr open };
allow chg_sence gsi_metadata_file_type:dir { search };
allow chg_sence metadata_file:dir { search };
allow chg_sence gsi_public_metadata_file:file { ioctl read getattr lock map open watch watch_reads };
allow chg_sence proc_bootconfig:file { ioctl read getattr lock map open watch watch_reads };
allow chg_sence proc_cmdline:file { ioctl read getattr lock map open watch watch_reads };

allow factory sysfs_cc_status:file { ioctl read write getattr lock append map open watch watch_reads };

allow platform_app sysfs_chgspeed_ctl_file:dir { read getattr open search };
allow platform_app sysfs_chgspeed_ctl_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow shell sysfs_chgspeed_ctl_file:dir { read getattr open search };
allow shell sysfs_chgspeed_ctl_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow system_app sysfs_chgspeed_ctl_file:dir { read getattr open search };
allow system_app sysfs_chgspeed_ctl_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow system_server sysfs_chgspeed_ctl_file:dir { read getattr open search };
allow system_server sysfs_chgspeed_ctl_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow init sysfs_chgspeed_ctl_file:dir { read getattr open search };
allow init sysfs_chgspeed_ctl_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow vendor_init sysfs_chgspeed_ctl_file:dir { read getattr open search };
allow vendor_init sysfs_chgspeed_ctl_file:file { ioctl read write getattr lock append map open watch watch_reads };

